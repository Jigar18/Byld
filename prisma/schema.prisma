// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String              @id @default(uuid())
  githubId                    String              @unique
  username                    String              @unique
  installationId              String?             @unique
  accessToken                 String?
  githubRefreshToken          String?
  githubAccessTokenUpdatedAt  DateTime?
  githubAccessTokenExpiresAt  DateTime?
  githubRefreshTokenExpiresAt DateTime?
  showGitHubHeatmap           Boolean             @default(true)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  skills                      Skill[]
  experiences                 Experience[]
  details                     Details?
  socialLinks                 SocialLink[]
  certifications              Certifications[]
  education                   Education[]
  projects                    Project[]
  portfolioViews              PortfolioView[]
  githubInstallation          GitHubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
}

model PortfolioView {
  id              String   @id @default(uuid())
  portfolioUser   User     @relation(fields: [portfolioUserId], references: [id], onDelete: Cascade)
  portfolioUserId String
  visitorKeyHash  String
  firstViewedAt   DateTime @default(now())
  lastViewedAt    DateTime @updatedAt

  @@unique([portfolioUserId, visitorKeyHash])
  @@index([portfolioUserId])
}

model Details {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String
  location  String
  jobTitle  String
  college   String
  startYear Int
  endYear   Int
  about     String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String  @unique
  imageUrl  String?
}

model Skill {
  id      String   @id @default(uuid())
  skills  String[]
  iconMap Json?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@index([userId])
}

model Experience {
  id            String   @id @default(uuid())
  company       String
  position      String
  startMonth    String
  startYear     String
  endMonth      String?
  endYear       String?
  isCurrentRole Boolean  @default(false)
  contributions String[]
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model SocialLink {
  id         String   @id @default(uuid())
  email      String?
  twitter    String?
  linkedin   String?
  instagram  String?
  github     String?
  medium     String?
  blog       String?
  leetcode   String?
  youtube    String?
  portfolio  String?
  hackerrank String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Certifications {
  id          String @id @default(uuid())
  title       String
  description String
  pdfUrl      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@index([userId])
}

model Education {
  id          String   @id @default(uuid())
  school      String
  degree      String
  field       String
  startYear   Int
  endYear     Int?
  isCurrently Boolean  @default(false)
  description String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Project {
  id            String         @id @default(uuid())
  title         String
  description   String
  techStack     String[]
  githubUrl     String?
  liveUrl       String?
  videoUrl      String?
  videoPublicId String?        @unique
  videoDuration Float?
  videoBytes    Int?
  videoFormat   String?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        ProjectImage[]

  @@index([userId])
}

model ProjectImage {
  id            String   @id @default(uuid())
  imageUrl      String
  imagePublicId String   @unique
  position      Int
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  createdAt     DateTime @default(now())

  @@unique([projectId, position])
  @@index([projectId])
}

model GitHubInstallation {
  id             String    @id
  accountId      String
  accountLogin   String
  accountType    String
  targetId       String?
  targetType     String?
  senderGithubId String?
  permissions    Json
  events         String[]
  suspendedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?

  @@index([accountId])
  @@index([senderGithubId])
}
